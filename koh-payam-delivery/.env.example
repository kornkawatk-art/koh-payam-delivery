# ---- Frontend (set these in Vercel project env) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_R2_PUBLIC_BASE_URL=
# LIFF app id for the /liff/register page (LINE Developers Console > LIFF tab).
# Public, not secret — safe to expose in the built frontend.
VITE_LIFF_ID=1234567890-abcdefgh

# ---- Local dev / CLI only (never commit real values; .env.local is gitignored) ----
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# ---- Supabase Edge Function secrets (set via: supabase secrets set …) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=koh-payam-photos
R2_PUBLIC_BASE_URL=
CLEANUP_SECRET=
# LINE channel id that register-line-contact verifies id tokens against
# (LINE Developers Console > channel basic settings). Server-side only.
LIFF_CHANNEL_ID=
# Messaging API channel access token that send-order-links uses to push order
# links to customers (LINE Developers Console > Messaging API tab). Server-side
# only, never expose in the built frontend.
LINE_CHANNEL_ACCESS_TOKEN=
# The deployed site's own base URL (e.g. https://koh-payam.vercel.app), used by
# send-order-links to build the /o/<token> link it pushes over LINE — the
# edge function has no browser `location.origin` to read this from.
SITE_URL=
